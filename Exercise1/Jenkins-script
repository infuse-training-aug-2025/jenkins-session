pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/infuse-training-aug-2025/jenkins-session'
        GIT_BRANCH = 'Jeevesh'
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: "${GIT_BRANCH}", url: "${GIT_REPO}"
            }
        }
        
        stage('Switch to Branch') {
            steps {
                bat "git checkout ${GIT_BRANCH}"
            }
        }

        stage('Run Batch File') {
            steps {
                // Run the BAT file
                bat 'call Exercise1\\generate_random_number.bat'
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up workspace...'
            deleteDir()
        }
    }

    }