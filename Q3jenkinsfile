pipeline {
    agent any

    stages {
        stage('Parallel Tasks') {
            parallel {
                stage('Fast Task') {
                    steps {
                        echo 'Starting fast task...'
                        bat 'ping -n 6 127.0.0.1 > nul'  // ~5 seconds
                        echo 'Fast task complete.'
                    }
                }
                stage('Slow Task') {
                    steps {
                        echo 'Starting slow task...'
                        bat 'ping -n 16 127.0.0.1 > nul'  // ~15 seconds
                        echo 'Slow task complete.'
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished (parallel execution).'
        }
    }
}

