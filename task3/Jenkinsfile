pipeline {
    agent any

    stages {
        stage('Parallel Tasks') {
            parallel {
                stage('Fast Task (~5 sec)') {
                    steps {
                        echo 'Running fast task...'
                        bat 'ping -n 6 127.0.0.1 > nul'
                        echo '✅ Fast task complete'
                    }
                }
                stage('Slow Task (~15 sec)') {
                    steps {
                        echo 'Running slow task...'
                        bat 'ping -n 16 127.0.0.1 > nul'
                        echo '✅ Slow task complete'
                    }
                }
            }
        }
    }
}
