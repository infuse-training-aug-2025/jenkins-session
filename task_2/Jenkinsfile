pipeline {
    agent any

    stages {
        stage('Fast Task') {
            steps {
                echo 'Starting fast task (~5 seconds)'
                bat 'ping -n 6 127.0.0.1 > nul'

                echo 'Fast task completed'
            }
        }

        stage('Slow Task') {
            steps {
                echo 'Starting slow task (~15 seconds)'
                bat 'ping -n 16 127.0.0.1 > nul'

                echo 'Slow task completed'
            }
        }
    }

    post {
        success {
            echo 'All tasks completed successfully!'
        }
        failure {
            echo 'One of the tasks failed.'
        }
    }
}
